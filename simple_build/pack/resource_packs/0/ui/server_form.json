				}
			},
			{
				"foreground": {
					"type": "image",
					"texture": "textures/edu_tools/ui/form_foreground",
					"size": [
						256,
						256
					],
					"layer": 30,
					"$title_needs_to_contain": "edu_tools.",
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "edu_tools_form_background",
							"source_property_name": "(not ((#title_text - $title_needs_to_contain) = #title_text))",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	},
	"main_screen_content": {
		"modifications": [
			{
